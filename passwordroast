                    log(`${name}${vram}${hourly}${daily}`);

                    if (gpu.hashcatBenchmark) {
                        log(`${colors.dim}  Hashcat: ${Object.entries(gpu.hashcatBenchmark).map(([k,v]) => `${k}=${v}`).join(', ')}${colors.reset}`);
