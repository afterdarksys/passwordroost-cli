function md4(data) {
    // Simple MD4 implementation for S/Key
    // In production, use a proper crypto library
    return crypto.createHash('md5').update(data).digest(); // Fallback to MD5 for demo
}

function skeyGenerate(seed, passphrase, sequence) {
    let hash = md4(seed.toLowerCase() + passphrase);
    for (let i = 0; i < sequence; i++) {
        hash = md4(hash);
    }
    return hash.slice(0, 8).toString('hex').toUpperCase();
}

// Prompt for password securely
function promptPassword(prompt) {
    return new Promise((resolve) => {
        const rl = readline.createInterface({
            input: process.stdin,
            output: process.stdout,
        });

        process.stdout.write(prompt);

        // This is a simplified version - in production, use a proper masked input library
        rl.question('', (answer) => {
            rl.close();
            resolve(answer);
        });
    });
}

