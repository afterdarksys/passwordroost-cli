                log(`\n${colors.bold}Common Hashes:${colors.reset}`);
                for (const type of result.hashTypes.filter(t => t.category === 'hash')) {
                    log(`  ${type.id.padEnd(15)} Mode ${String(type.hashcatMode).padEnd(6)} ${type.name}`);
                }
                break;
            }

            case 'crack': {
                const hashType = args[1];
                const filePath = args[2];

                if (!hashType || !filePath) {
                    error('Usage: passwordroast crack <hash-type> <file> [options]');
                    process.exit(1);
                }

                if (!fs.existsSync(filePath)) {
                    error(`File not found: ${filePath}`);
                    process.exit(1);
                }

                const gpuIndex = args.indexOf('--gpu');
                const hoursIndex = args.indexOf('--hours');
                const wordlistIndex = args.indexOf('--wordlist');
                const emailIndex = args.indexOf('--email');

                const gpuType = gpuIndex >= 0 ? args[gpuIndex + 1] : 'rtx4090';
                const hours = hoursIndex >= 0 ? parseInt(args[hoursIndex + 1]) : 1;
                const wordlist = wordlistIndex >= 0 ? args[wordlistIndex + 1] : 'rockyou';

                const config = loadConfig();
                const email = emailIndex >= 0 ? args[emailIndex + 1] : config.email;

                // Read and encode hash file
                const hashData = fs.readFileSync(filePath).toString('base64');

                header('Submitting Crack Job');
                info(`Hash Type: ${hashType}`);
                info(`File: ${filePath}`);
                info(`GPU: ${gpuType}`);
                info(`Duration: ${hours} hours`);
                info(`Wordlist: ${wordlist}`);
                if (email) info(`Email: ${email}`);

                log('\nSubmitting job...');

                const result = await apiRequest('/api/gpu/crack-jobs', 'POST', {
                    hashType,
                    hashData,
                    hashFileName: path.basename(filePath),
                    gpuType,
                    gpuCount: 1,
                    rentalHours: hours,
                    wordlist,
