                if (subcommand === 'set') {
                    const key = args[2];
                    const value = args[3];

                    if (!key || !value) {
                        error('Usage: passwordroast config set <key> <value>');
                        process.exit(1);
                    }

                    config[key] = value;
                    saveConfig(config);
                    success(`Set ${key} = ${value}`);
                } else if (subcommand === 'show') {
                    header('Configuration');
                    log(`Config file: ${CONFIG_FILE}`);
                    log(`API URL: ${API_BASE}`);
                    log(`Email: ${config.email || '(not set)'}`);

                    for (const [key, value] of Object.entries(config)) {
                        log(`${key}: ${value}`);
                    }
                } else {
                    error('Usage: passwordroast config <set|show>');
                }
                break;
            }

            default:
                error(`Unknown command: ${command}`);
                log('\nRun "passwordroast --help" for usage information.');
                process.exit(1);
        }
    } catch (err) {
        error(err.message);
        process.exit(1);
    }
}

main();
