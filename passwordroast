// Main CLI entry point
async function main() {
    const args = process.argv.slice(2);
    const command = args[0];

    if (!command || command === '--help' || command === '-h') {
        showHelp();
        process.exit(0);
    }

    try {
        switch (command) {
            case 'check': {
                let password;
                const verbose = args.includes('-v') || args.includes('--verbose');

                if (args.includes('--stdin')) {
                    // Read from stdin
                    const chunks = [];
                    for await (const chunk of process.stdin) {
                        chunks.push(chunk);
                    }
                    password = Buffer.concat(chunks).toString().trim();
                } else if (args.includes('--hash')) {
                    const hashIndex = args.indexOf('--hash');
                    const hash = args[hashIndex + 1];
                    if (!hash || hash.length !== 40) {
                        error('Invalid SHA-1 hash (must be 40 hex characters)');
                        process.exit(1);
                    }
                    // Check by hash directly
                    const prefix = hash.substring(0, 5).toUpperCase();
                    const suffix = hash.substring(5).toUpperCase();

                    info(`Checking hash: ${hash}`);
                    const result = await apiRequest(`/api/hibp/${prefix}`);

                    const lines = result.data.split('\r\n');
                    let breachCount = 0;
                    for (const line of lines) {
                        const [lineSuffix, count] = line.split(':');
                        if (lineSuffix === suffix) {
                            breachCount = parseInt(count, 10);
                            break;
                        }
                    }

                    if (breachCount > 0) {
                        log(`\n${colors.bgRed}${colors.white} BREACHED ${colors.reset}`);
                        error(`This hash appears in ${breachCount.toLocaleString()} data breaches!`);
                    } else {
                        log(`\n${colors.bgGreen}${colors.white} SAFE ${colors.reset}`);
                        success('This hash was not found in known data breaches.');
                    }
                    process.exit(breachCount > 0 ? 1 : 0);
                } else if (args.includes('--file')) {
                    const fileIndex = args.indexOf('--file');
                    const filePath = args[fileIndex + 1];
                    if (!filePath || !fs.existsSync(filePath)) {
                        error('File not found');
                        process.exit(1);
                    }

                    const passwords = fs.readFileSync(filePath, 'utf8').split('\n').filter(p => p.trim());
                    info(`Checking ${passwords.length} passwords...\n`);

                    let breached = 0;
                    let safe = 0;

                    for (const pwd of passwords) {
                        const result = await checkPassword(pwd.trim());
                        if (result.breached) {
                            log(`${colors.red}BREACHED${colors.reset} (${result.count.toLocaleString()}): ${pwd.substring(0, 3)}***`);
                            breached++;
                        } else {
                            log(`${colors.green}SAFE${colors.reset}: ${pwd.substring(0, 3)}***`);
                            safe++;
                        }
                    }

                    log(`\n${colors.bold}Summary:${colors.reset}`);
                    log(`  Safe: ${safe}`);
                    log(`  Breached: ${breached}`);
                    process.exit(breached > 0 ? 1 : 0);
                } else {
                    password = args[1];
                    if (!password) {
                        password = await promptPassword('Enter password to check: ');
                    }
                }

                if (password) {
                    info('Checking password against breach databases...\n');
                    const result = await checkPassword(password, verbose);

                    if (result.breached) {
                        log(`${colors.bgRed}${colors.white} BREACHED ${colors.reset}`);
                        error(`This password appears in ${result.count.toLocaleString()} data breaches!`);
                        warn('You should change this password immediately.');
                    } else {
                        log(`${colors.bgGreen}${colors.white} SAFE ${colors.reset}`);
                        success('This password was not found in known data breaches.');
                    }

                    if (verbose) {
                        log(`\n${colors.dim}Cache: ${result.fromCache ? 'HIT' : 'MISS'}${colors.reset}`);
                    }

                    process.exit(result.breached ? 1 : 0);
                }
                break;
            }

            case 'generate': {
                const length = parseInt(args[1]) || 16;
                const options = {
                    symbols: !args.includes('--no-symbols'),
                    numbers: !args.includes('--no-numbers'),
                    uppercase: !args.includes('--no-uppercase'),
                    lowercase: !args.includes('--no-lowercase'),
                };

                const password = generatePassword(length, options);

                header('Generated Password');
                log(colors.bold + colors.green + password + colors.reset);
                log(`\n${colors.dim}Length: ${length} characters${colors.reset}`);

                // Calculate entropy
                let charset = 0;
                if (options.lowercase) charset += 26;
                if (options.uppercase) charset += 26;
                if (options.numbers) charset += 10;
                if (options.symbols) charset += 32;
                const entropy = Math.log2(Math.pow(charset, length));
                log(`${colors.dim}Entropy: ~${entropy.toFixed(0)} bits${colors.reset}`);
                break;
            }

            case 'passphrase': {
                const wordCount = parseInt(args[1]) || 6;
                const sepIndex = args.indexOf('--separator');
                const separator = sepIndex >= 0 ? args[sepIndex + 1] : '-';

                const passphrase = generatePassphrase(wordCount, separator);

                header('Generated Passphrase');
                log(colors.bold + colors.green + passphrase + colors.reset);
                log(`\n${colors.dim}Words: ${wordCount}${colors.reset}`);

                // Diceware entropy: ~12.9 bits per word
                const entropy = wordCount * 12.9;
                log(`${colors.dim}Entropy: ~${entropy.toFixed(0)} bits${colors.reset}`);
                break;
            }

            case 'gpus': {
                header('Available GPUs');
                info('Fetching GPU pricing from AIServe.farm...\n');

