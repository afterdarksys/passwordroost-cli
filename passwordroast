            case 'status': {
                const jobId = args[1];
                if (!jobId) {
                    error('Usage: passwordroast status <job-id>');
                    process.exit(1);
                }

                const result = await apiRequest(`/api/jobs/${jobId}`);

                header(`Job Status: ${result.jobId}`);
                log(`Breach Count: ${result.breachCount.toLocaleString()}`);
                log(`Previous Count: ${result.lastBreachCount.toLocaleString()}`);

                if (result.newBreachesDetected) {
                    warn(`\n⚠️  NEW BREACHES DETECTED!`);
                    warn(`   ${result.breachCount - result.lastBreachCount} new breaches since last check.`);
                }

                log(`\nAlerts: ${result.alertEnabled ? 'Enabled' : 'Disabled'}`);
                if (result.email) log(`Email: ${result.email}`);
                log(`Created: ${result.createdAt}`);
                if (result.lastCheckedAt) log(`Last Checked: ${result.lastCheckedAt}`);
                break;
            }

            case 'skey': {
                const subcommand = args[1];

                if (subcommand === 'generate') {
                    const seed = args[2];
                    const sequence = parseInt(args[3]);

                    if (!seed || !sequence) {
                        error('Usage: passwordroast skey generate <seed> <sequence>');
                        process.exit(1);
                    }

                    const passphrase = await promptPassword('Enter passphrase: ');
                    const otp = skeyGenerate(seed, passphrase, sequence);

                    header('S/Key OTP');
                    log(`Seed: ${seed}`);
                    log(`Sequence: ${sequence}`);
                    log(`\nOTP: ${colors.bold}${colors.green}${otp}${colors.reset}`);
                } else if (subcommand === 'solve') {
                    const challenge = args[2];
                    if (!challenge) {
                        error('Usage: passwordroast skey solve <challenge>');
                        process.exit(1);
                    }

                    // Parse challenge like "otp-md5 498 dog2"
                    const parts = challenge.split(' ');
                    const algorithm = parts[0] || 'otp-md5';
                    const sequence = parseInt(parts[1]);
                    const seed = parts[2];

                    if (!sequence || !seed) {
                        error('Invalid challenge format. Expected: "<algorithm> <sequence> <seed>"');
                        process.exit(1);
                    }

                    const passphrase = await promptPassword('Enter passphrase: ');
                    const otp = skeyGenerate(seed, passphrase, sequence);

                    header('S/Key Solution');
                    log(`Challenge: ${challenge}`);
                    log(`\nOTP: ${colors.bold}${colors.green}${otp}${colors.reset}`);
                } else {
                    error('Usage: passwordroast skey <generate|solve> ...');
                }
                break;
