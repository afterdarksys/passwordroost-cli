                info('Checking password and setting up monitoring...\n');

                const checkResult = await checkPassword(password);

                const result = await apiRequest('/api/jobs', 'POST', {
                    hashPrefix: checkResult.prefix,
                    hashSuffix: checkResult.suffix,
                    breachCount: checkResult.count,
                    email: config.email,
                });

                header(`Monitoring Job: ${result.jobId}`);

                if (checkResult.breached) {
                    warn(`Current breach count: ${checkResult.count.toLocaleString()}`);
                } else {
                    success('Password not currently breached');
                }

                log(`\nJob ID: ${colors.bold}${result.jobId}${colors.reset}`);
                log('Save this ID to check status later.');

                if (!result.existing) {
                    success('\nMonitoring enabled. You will be notified of new breaches.');
