function generatePassphrase(wordCount = 6, separator = '-') {
    const words = [];
    const randomBytes = crypto.randomBytes(wordCount * 2);
    for (let i = 0; i < wordCount; i++) {
        const index = randomBytes.readUInt16BE(i * 2) % DICEWARE_WORDS.length;
        words.push(DICEWARE_WORDS[index]);
    }
    return words.join(separator);
}

