                    running: colors.green,
                    completed: colors.green,
                    failed: colors.red,
                    cancelled: colors.dim,
                }[result.status] || '';

                log(`Status: ${statusColor}${result.status.toUpperCase()}${colors.reset}`);
                log(`Hash Type: ${result.hashType}`);
                log(`GPU: ${result.gpuType} x${result.gpuCount}`);
                log(`Duration: ${result.rentalHours} hours`);

                if (result.progress > 0) {
                    log(`\nProgress: ${result.progress.toFixed(1)}%`);
                    if (result.speed) log(`Speed: ${result.speed}`);
                    if (result.eta) log(`ETA: ${result.eta}`);
