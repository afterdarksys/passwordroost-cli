#!/usr/bin/env node

/**
 * Password Roast CLI
 * Comprehensive command-line tool for password security operations
 *
 * Features:
 * - Check passwords against HIBP/XposedOrNot breach databases
 * - Monitor passwords for new breaches
 * - Generate secure passwords and passphrases
 * - Submit GPU-powered hash cracking jobs
 * - Extract hashes from PCAP files (cap2hashcat)
 * - S/Key OTP generation and solving
 */

const crypto = require('crypto');
const fs = require('fs');
const path = require('path');
const readline = require('readline');

// Configuration
const API_BASE = process.env.PASSWORDROAST_API || 'https://passwordroost.com';
const CONFIG_FILE = path.join(process.env.HOME || '~', '.passwordroast.json');

// ANSI color codes
const colors = {
    reset: '\x1b[0m',
    bold: '\x1b[1m',
    dim: '\x1b[2m',
    red: '\x1b[31m',
    green: '\x1b[32m',
    yellow: '\x1b[33m',
    blue: '\x1b[34m',
    magenta: '\x1b[35m',
    cyan: '\x1b[36m',
    white: '\x1b[37m',
    bgRed: '\x1b[41m',
    bgGreen: '\x1b[42m',
};

// Helper functions
function log(msg, color = '') {
    console.log(color + msg + colors.reset);
}

function error(msg) {
    console.error(colors.red + 'Error: ' + msg + colors.reset);
}

function success(msg) {
    log(msg, colors.green);
}

function warn(msg) {
    log(msg, colors.yellow);
}

function info(msg) {
    log(msg, colors.cyan);
}

function header(msg) {
    log('\n' + colors.bold + colors.magenta + '='.repeat(50) + colors.reset);
    log(colors.bold + colors.magenta + ' ' + msg + colors.reset);
    log(colors.bold + colors.magenta + '='.repeat(50) + colors.reset + '\n');
}

// Load/save config
function loadConfig() {
    try {
        if (fs.existsSync(CONFIG_FILE)) {
            return JSON.parse(fs.readFileSync(CONFIG_FILE, 'utf8'));
        }
    } catch (e) {}
    return {};
}

function saveConfig(config) {
    fs.writeFileSync(CONFIG_FILE, JSON.stringify(config, null, 2));
}

// SHA-1 hash a password
function sha1(password) {
    return crypto.createHash('sha1').update(password).digest('hex').toUpperCase();
}

// API request helper
async function apiRequest(endpoint, method = 'GET', body = null) {
    const options = {
        method,
        headers: {
            'Content-Type': 'application/json',
            'User-Agent': 'PasswordRoast-CLI/1.0',
        },
    };
    if (body) {
        options.body = JSON.stringify(body);
    }

    const response = await fetch(`${API_BASE}${endpoint}`, options);
    if (!response.ok) {
        const errorText = await response.text();
        throw new Error(`API error (${response.status}): ${errorText}`);
    }
    return response.json();
}

// Check password against HIBP
async function checkPassword(password, verbose = false) {
    const hash = sha1(password);
    const prefix = hash.substring(0, 5);
    const suffix = hash.substring(5);

    if (verbose) {
        info(`SHA-1: ${hash}`);
        info(`Prefix: ${prefix}, Suffix: ${suffix}`);
    }

    try {
        const result = await apiRequest(`/api/hibp/${prefix}`);

        // Parse response to find breach count
        const lines = result.data.split('\r\n');
        let breachCount = 0;

        for (const line of lines) {
            const [lineSuffix, count] = line.split(':');
            if (lineSuffix === suffix) {
                breachCount = parseInt(count, 10);
                break;
            }
        }

        return {
            breached: breachCount > 0,
            count: breachCount,
            hash,
            prefix,
            suffix,
            fromCache: result.fromCache,
        };
    } catch (err) {
        throw new Error(`Failed to check password: ${err.message}`);
    }
}

// Generate secure password
function generatePassword(length = 16, options = {}) {
    const lowercase = 'abcdefghijklmnopqrstuvwxyz';
    const uppercase = 'ABCDEFGHIJKLMNOPQRSTUVWXYZ';
    const numbers = '0123456789';
    const symbols = '!@#$%^&*()_+-=[]{}|;:,.<>?';

    let charset = '';
    if (options.lowercase !== false) charset += lowercase;
    if (options.uppercase !== false) charset += uppercase;
    if (options.numbers !== false) charset += numbers;
    if (options.symbols !== false) charset += symbols;

    let password = '';
    const randomBytes = crypto.randomBytes(length);
    for (let i = 0; i < length; i++) {
        password += charset[randomBytes[i] % charset.length];
    }

    return password;
}

